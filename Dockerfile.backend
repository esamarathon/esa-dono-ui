# syntax=docker/dockerfile:1.7
# Backend image for esa-dono-ui (Express + Prisma API server).
#
# Targets:
#   test    - full dev deps + source, entrypoint runs scripts/run-tests.ts (CI/distributed testing)
#   runtime - production API server, prod-only deps, non-root, migrates on start
#
# Build:
#   docker build -f Dockerfile.backend --target runtime -t esa-dono-ui/backend:latest .
#   docker build -f Dockerfile.backend --target test    -t esa-dono-ui/backend:test    .

# ---------- Base ----------
FROM docker.io/node:22-slim AS base

LABEL org.opencontainers.image.title="esa-dono-ui-backend" \
      org.opencontainers.image.description="ESA charity donation platform API (Tiltify integration)" \
      org.opencontainers.image.source="https://github.com/Codescales/esa-dono-ui" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.vendor="ESA"

ENV NPM_CONFIG_LOGLEVEL=warn \
    NPM_CONFIG_UPDATE_NOTIFIER=false \
    CI=true

# openssl is required by Prisma engines; ca-certificates for outbound HTTPS (Tiltify/SMTP)
# apt-get upgrade patches OS-level CVEs present in the base image (e.g. libgnutls30)
RUN apt-get update -y \
 && apt-get upgrade -y \
 && apt-get install -y --no-install-recommends openssl ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && groupadd --system --gid 1001 dono \
 && useradd  --system --uid 1001 --gid dono --home /app --shell /sbin/nologin dono

WORKDIR /app

# ---------- Dependencies (cached layer, includes dev deps) ----------
FROM base AS deps

COPY package.json package-lock.json ./
COPY server/package.json ./server/
COPY client/package.json ./client/
COPY packages/shared/package.json ./packages/shared/

RUN --mount=type=cache,target=/root/.npm,id=npm \
    npm ci --no-audit --no-fund --include=dev

# ---------- Runtime dependencies (production deps + startup CLI tools) ----------
# Slimmer than `deps`: only production dependencies, plus the two CLIs needed to
# run the server (tsx) and apply migrations (prisma). Excludes vite/vitest/
# esbuild(build)/tailwind/jsdom/testing tooling that would otherwise be scanned.
FROM base AS runtime-deps

COPY package.json package-lock.json ./
COPY server/package.json ./server/
COPY client/package.json ./client/
COPY packages/shared/package.json ./packages/shared/

RUN --mount=type=cache,target=/root/.npm,id=npm \
    npm ci --no-audit --no-fund --omit=dev

# ---------- Test target (distributed testing / CI) ----------
FROM deps AS test

ENV NODE_ENV=test \
    DATABASE_URL="file:/app/server/prisma/dev.db" \
    PATH="/app/node_modules/.bin:${PATH}"

COPY --chown=dono:dono . .

# NOTE: DATABASE_URL must point at the exact path server/vitest.config.ts
# forces at test-run time (file:<server>/prisma/dev.db). The prisma CLI
# resolves a *relative* sqlite URL against the schema file's directory, but
# a generated PrismaClient (as used by vitest) resolves it against
# process.cwd() instead — an absolute path here sidesteps that mismatch by
# being unambiguous for both. If this ever drifts from vitest.config.ts's
# DATABASE_URL again, every test hits "table does not exist" (P2021)
# because db push wrote the schema to a different file than tests open.
RUN DATABASE_URL="file:/app/server/prisma/dev.db" npx prisma generate --schema=./server/prisma/schema.prisma \
  && DATABASE_URL="file:/app/server/prisma/dev.db" npx prisma db push --accept-data-loss --schema=./server/prisma/schema.prisma \
  && chown -R dono:dono /app

USER dono
ENTRYPOINT ["node_modules/.bin/tsx", "scripts/run-tests.ts"]

# ---------- Runtime (production API) ----------
FROM runtime-deps AS runtime

ENV NODE_ENV=production \
    PORT=3001 \
    DATABASE_URL="file:/data/dono.db"

# Only the server, prisma schema, shared package, and shared root files are needed at runtime.
COPY --chown=dono:dono server ./server
COPY --chown=dono:dono packages ./packages
COPY --chown=dono:dono tsconfig.base.json ./
COPY --chown=dono:dono package.json package-lock.json ./
COPY --chown=dono:dono docker-entrypoint.backend.sh /usr/local/bin/docker-entrypoint.sh

# The Prisma CLI is a production dependency (needed at startup for
# `prisma migrate deploy`), so no dev toolchain is shipped.
RUN DATABASE_URL="file:./dev.db" npx prisma generate --schema=./server/prisma/schema.prisma \
 && chmod +x /usr/local/bin/docker-entrypoint.sh \
 && mkdir -p /data/uploads && chown dono:dono /data /data/uploads

# Strip the npm CLI + corepack bundled into the Node base image. Nothing at
# runtime invokes npm/npx (entrypoint uses node_modules/.bin/*), and their
# bundled dependency tree is the source of a cluster of high-severity CVEs.
RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack \
 && rm -f /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack

VOLUME ["/data"]
USER dono
EXPOSE 3001

HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD node -e "require('http').get('http://localhost:3001/api/health',r=>process.exit(r.statusCode===200?0:1)).on('error',()=>process.exit(1))"

ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
CMD ["node_modules/.bin/tsx", "server/index.ts"]
