# syntax=docker/dockerfile:1.7
# Frontend image for esa-dono-ui: builds the Vite SPA and serves it via nginx,
# proxying /api to the backend service.
#
# Build:
#   docker build -f Dockerfile.frontend -t esa-dono-ui/frontend:latest .

# ---------- Build ----------
FROM docker.io/node:20-slim AS builder

WORKDIR /app
ENV NPM_CONFIG_LOGLEVEL=warn \
    NPM_CONFIG_UPDATE_NOTIFIER=false \
    CI=true

COPY package.json package-lock.json ./
COPY client/package.json ./client/
# server manifest is referenced by the root workspace install
COPY server/package.json ./server/
COPY packages/shared/package.json ./packages/shared/

RUN --mount=type=cache,target=/root/.npm,id=npm \
    npm ci --no-audit --no-fund --workspace client --workspace @dono/shared --include-workspace-root

COPY tsconfig.base.json ./
COPY packages ./packages
COPY client ./client
RUN npm run build --workspace client

# ---------- Serve ----------
FROM docker.io/nginxinc/nginx-unprivileged:1.27-alpine AS runner

LABEL org.opencontainers.image.title="esa-dono-ui-frontend" \
      org.opencontainers.image.description="ESA charity donation platform SPA (nginx)" \
      org.opencontainers.image.source="https://github.com/Codescales/esa-dono-ui" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.vendor="ESA"

# Patch OS packages to fix CVEs in the base image (e.g. libcrypto3/OpenSSL)
USER root
RUN apk upgrade --no-cache
USER nginx

COPY nginx.conf /etc/nginx/templates/default.conf.template
COPY --from=builder /app/client/dist /usr/share/nginx/html

# Enable the built-in 15-local-resolvers script to populate NGINX_LOCAL_RESOLVERS
# from /etc/resolv.conf (portable across Docker & Podman DNS).
ENV NGINX_ENTRYPOINT_LOCAL_RESOLVERS=1

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -q -O /dev/null http://localhost:8080/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
