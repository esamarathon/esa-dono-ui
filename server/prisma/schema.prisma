generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Donor {
  id                String          @id @default(cuid())
  email             String          @unique
  total_donated     Int             @default(0)
  balance_remaining Int             @default(0)
  magic_token       String?         @unique
  token_expires_at  DateTime?
  role              String          @default("USER") // USER | MODERATOR | ADMIN
  // Set to true only after a verified OAuth login (Google/Discord). Required
  // for ADMIN_EMAILS/MODERATOR_EMAILS allowlist role resolution — a Stripe
  // checkout email is self-supplied and never counts as verified.
  email_verified    Boolean         @default(false)
  is_frozen         Boolean         @default(false)
  created_at        DateTime        @default(now())
  updated_at        DateTime        @updatedAt
  donations         Donation[]
  reward_claims     RewardClaim[]
  poll_votes        PollVote[]
  fund_contributions FundContribution[]
  balance_adjustments BalanceAdjustment[]
  custom_entries    PollCustomEntry[]
  bids              Bid[]
  auction_offers    AuctionOffer[]
  auction_wins      AuctionWin[]
  current_bid_auctions Auction[] @relation("CurrentBidder")
}

model Donation {
  id          String   @id @default(cuid())
  external_id String   @unique
  donor_id    String
  amount_cents Int
  donor_name  String?
  comment     String?
  moderated    Boolean   @default(false)
  moderated_at DateTime?
  moderated_by String?
  channel_id  String?
  created_at  DateTime @default(now())
  donor       Donor    @relation(fields: [donor_id], references: [id])
  channel     Channel? @relation(fields: [channel_id], references: [id])
  pledge      PendingPledge?
}

model Channel {
  id         String          @id @default(cuid())
  name       String          @unique
  is_active  Boolean         @default(true)
  created_at DateTime        @default(now())
  updated_at DateTime        @updatedAt
  rewards    Reward[]
  polls      Poll[]
  goals      FundGoal[]
  donations  Donation[]
  pledges    PendingPledge[]
  auctions   Auction[]
}

model Reward {
  id               String        @id @default(cuid())
  title            String
  description      String?
  type             String        // DIGITAL | PHYSICAL | SHOUTOUT | CUSTOM
  cost_cents       Int
  quantity_total   Int?
  quantity_claimed Int           @default(0)
  is_active        Boolean       @default(true)
  custom_type_label String?
  image_url        String?       // served at /api/uploads/<uuid>.webp
  channel_id        String?       // null = shared across all channels
  created_at       DateTime      @default(now())
  updated_at       DateTime      @updatedAt
  claims           RewardClaim[]
  channel          Channel?      @relation(fields: [channel_id], references: [id])
}

model RewardClaim {
  id         String   @id @default(cuid())
  reward_id  String
  donor_id   String
  status     String   @default("PENDING") // PENDING | FULFILLED | REVERSED
  claim_data String?  // JSON string
  reversed_at DateTime?
  reversed_by String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  reward     Reward   @relation(fields: [reward_id], references: [id])
  donor      Donor    @relation(fields: [donor_id], references: [id])
}

model Poll {
  id                   String       @id @default(cuid())
  title                String
  description          String?
  is_active            Boolean      @default(true)
  ends_at              DateTime?
  total_votes_cents    Int          @default(0)
  allow_custom_entries Boolean      @default(false)
  max_entry_chars      Int?
  auto_approve         Boolean      @default(true)
  channel_id           String?      // null = shared across all channels
  created_at           DateTime     @default(now())
  updated_at           DateTime     @updatedAt
  options              PollOption[]
  votes                PollVote[]
  custom_entries       PollCustomEntry[]
  channel              Channel?     @relation(fields: [channel_id], references: [id])
}

model PollOption {
  id              String          @id @default(cuid())
  poll_id         String
  label           String
  votes_cents     Int             @default(0)
  status          String          @default("ACTIVE") // ACTIVE | PENDING_APPROVAL | REJECTED
  custom_entry_id String?         @unique
  poll            Poll            @relation(fields: [poll_id], references: [id], onDelete: Cascade)
  votes           PollVote[]
  custom_entry    PollCustomEntry? @relation(fields: [custom_entry_id], references: [id])
}

model PollVote {
  id             String     @id @default(cuid())
  poll_id        String
  poll_option_id String
  donor_id       String
  amount_cents   Int
  reversed_at    DateTime?
  reversed_by    String?
  created_at     DateTime   @default(now())
  poll           Poll       @relation(fields: [poll_id], references: [id])
  poll_option    PollOption @relation(fields: [poll_option_id], references: [id])
  donor          Donor      @relation(fields: [donor_id], references: [id])
}

model PollCustomEntry {
  id         String   @id @default(cuid())
  poll_id    String
  donor_id   String
  label      String
  status     String   @default("PENDING") // PENDING | APPROVED | REJECTED
  created_at DateTime @default(now())
  poll       Poll     @relation(fields: [poll_id], references: [id], onDelete: Cascade)
  donor      Donor    @relation(fields: [donor_id], references: [id])
  option     PollOption?
}

model BlockedWord {
  id   String @id @default(cuid())
  word String @unique
}

model FundGoal {
  id            String             @id @default(cuid())
  title         String
  description   String?
  target_cents  Int
  current_cents Int                @default(0)
  is_active     Boolean            @default(true)
  is_complete   Boolean            @default(false)
  channel_id    String?            // null = shared across all channels
  created_at    DateTime           @default(now())
  updated_at    DateTime           @updatedAt
  contributions FundContribution[]
  channel       Channel?           @relation(fields: [channel_id], references: [id])
}

model FundContribution {
  id           String   @id @default(cuid())
  goal_id      String
  donor_id     String
  amount_cents Int
  reversed_at  DateTime?
  reversed_by  String?
  created_at   DateTime @default(now())
  goal         FundGoal @relation(fields: [goal_id], references: [id])
  donor        Donor    @relation(fields: [donor_id], references: [id])
}

model BalanceAdjustment {
  id                String   @id @default(cuid())
  donor_id          String
  amount_cents      Int
  balance_after_cents Int
  type              String   // REFUND | FREEZE_ZERO | MANUAL | CHARGEBACK
  reason            String?
  reference_id      String?  // id of the reversed claim/vote/contribution
  created_by        String   @default("admin")
  created_at        DateTime @default(now())
  donor             Donor    @relation(fields: [donor_id], references: [id])
}

model PendingPledge {
  id                    String       @id @default(cuid())
  pledge_token          String       @unique
  donor_email           String?
  total_cents           Int
  top_up_cents          Int          @default(0) // optional additional donation beyond cart items
  wallet_discount_cents Int          @default(0) // cents deducted from existing wallet balance at checkout
  status                String       @default("OPEN") // OPEN | FULFILLED | EXPIRED | CANCELLED
  requires_shipping     Boolean      @default(false) // true when any cart item is a PHYSICAL reward
  checkout_session_id   String?      // Stripe Checkout Session id for deterministic linkage
  checkout_url          String?      // Stripe Checkout Session URL used in the redirect
  comment               String?      // donor comment captured in the cart before checkout
  channel_id            String?      // channel this donation routes to (required at creation)
  fulfilled_by_donation_id String? @unique
  created_at            DateTime     @default(now())
  expires_at            DateTime
  updated_at            DateTime     @updatedAt
  items                 PledgeItem[]
  fulfilled_by          Donation?    @relation(fields: [fulfilled_by_donation_id], references: [id])
  channel               Channel?     @relation(fields: [channel_id], references: [id])
}

model PledgeItem {
  id          String       @id @default(cuid())
  pledge_id   String
  kind        String       // REWARD | POLL_VOTE | GOAL | POLL_CUSTOM
  target_id   String       // reward_id | poll_option_id | goal_id | poll_id (POLL_CUSTOM)
  poll_id     String?      // required for POLL_VOTE and POLL_CUSTOM
  amount_cents Int
  data        String?      // JSON string for claim_data (shoutout message, custom reward fields, etc.)
  created_at  DateTime     @default(now())
  pledge      PendingPledge @relation(fields: [pledge_id], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Auctions (silent-auction / cascading-offer model)
//
// Bids are non-binding commitments — NOT wallet deductions (unlike rewards,
// polls, and goals). At close, the highest bidder is offered the item via a
// Stripe Checkout Session (24h window) that collects payment AND, for
// physical items, the shipping address natively on Stripe's side — the
// address never touches this application or database. If an offer expires
// unpaid, the cascade advances to the next-highest bidder at their own bid
// price, walking the entire ranked list until someone pays or it's
// exhausted (UNSOLD). See docs/adr for the full design rationale.
// ---------------------------------------------------------------------------

model Auction {
  id                  String          @id @default(cuid())
  title               String
  description         String?
  type                String          // DIGITAL | PHYSICAL | SHOUTOUT | CUSTOM
  custom_type_label   String?
  image_url           String?         // served at /api/uploads/<uuid>.webp
  starting_price_cents Int
  min_increment_cents Int
  current_bid_cents   Int?            // denormalized high bid, mirrors Bid rows
  current_bidder_id   String?
  ends_at             DateTime
  status              String          @default("OPEN") // OPEN | CLOSED | AWAITING_PAYMENT | SETTLED | UNSOLD | CANCELLED
  current_offer_id    String?         @unique
  channel_id          String?         // null = shared across all channels
  is_active           Boolean         @default(true)
  created_at          DateTime        @default(now())
  updated_at          DateTime        @updatedAt
  bids                Bid[]
  offers              AuctionOffer[]  @relation("AuctionOffers")
  current_offer       AuctionOffer?   @relation("CurrentOffer", fields: [current_offer_id], references: [id])
  win                 AuctionWin?
  channel             Channel?        @relation(fields: [channel_id], references: [id])
  current_bidder      Donor?          @relation("CurrentBidder", fields: [current_bidder_id], references: [id])
}

model Bid {
  id           String    @id @default(cuid())
  auction_id   String
  donor_id     String
  amount_cents Int
  rank         Int?      // stamped at close: 1 = highest, collapsed to one bid per donor
  status       String    @default("ACTIVE") // ACTIVE | OUTBID | OFFERED | WON | PASSED
  created_at   DateTime  @default(now())
  auction      Auction   @relation(fields: [auction_id], references: [id])
  donor        Donor     @relation(fields: [donor_id], references: [id])
}

model AuctionOffer {
  id                  String    @id @default(cuid())
  auction_id          String
  donor_id            String
  bid_id              String
  rank                Int
  amount_cents        Int
  checkout_session_id String?   @unique
  checkout_url        String?
  status              String    @default("SENT") // SENT | PAID | EXPIRED | SKIPPED
  expires_at          DateTime
  emailed_at          DateTime?
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt
  auction             Auction   @relation("AuctionOffers", fields: [auction_id], references: [id])
  current_for         Auction?  @relation("CurrentOffer")
  donor               Donor     @relation(fields: [donor_id], references: [id])
}

model AuctionWin {
  id                  String    @id @default(cuid())
  auction_id          String    @unique
  donor_id            String
  winning_bid_cents   Int
  checkout_session_id String
  status              String    @default("FULFILLED") // FULFILLED | REVERSED (reversal action reserved for future use)
  reversed_at         DateTime?
  reversed_by         String?
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt
  auction             Auction   @relation(fields: [auction_id], references: [id])
  donor               Donor     @relation(fields: [donor_id], references: [id])
}

model EventDestination {
  id               String          @id @default(cuid())
  url              String
  secret           String
  is_active        Boolean         @default(true)
  event_types      String          @default("[]")
  verify_ssl       Boolean         @default(true)
  description      String?
  created_at       DateTime        @default(now())
  updated_at       DateTime        @updatedAt
  deliveries       EventDelivery[]
  seq              EventDestinationSeq?
  destination_type String          @default("HTTP") // HTTP | RABBITMQ
  amqp_url         String?
  amqp_exchange    String          @default("")
  amqp_routing_key String?

  @@map("WebhookEndpoint")
}

model EventDestinationSeq {
  destination_id String           @id
  seq            Int              @default(0)
  destination    EventDestination @relation(fields: [destination_id], references: [id], onDelete: Cascade)

  @@map("WebhookEndpointSeq")
}

model EventDelivery {
  id               String          @id @default(cuid())
  seq              Int             @default(0)
  destination_id   String
  event_type       String
  payload          String
  status           String          @default("PENDING") // PENDING | SUCCESS | FAILED
  attempts         Int             @default(0)
  max_attempts     Int             @default(5)
  next_attempt_at  DateTime        @default(now())
  last_status_code Int?
  last_error       String?
  created_at       DateTime        @default(now())
  updated_at       DateTime        @updatedAt
  destination      EventDestination @relation(fields: [destination_id], references: [id], onDelete: Cascade)

  @@unique([destination_id, seq])
  @@map("WebhookDelivery")
}
