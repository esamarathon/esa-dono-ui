STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd
STRIPE_SHIPPING_RATE_ID=
STRIPE_SHIPPING_ALLOWED_COUNTRIES=US
CAMPAIGN_GOAL_CENTS=500000
ADMIN_API_KEY=change-me
MODERATOR_API_KEY=
ADMIN_EMAILS=
MODERATOR_EMAILS=
# Prometheus metrics. GET /api/metrics with `Authorization: Bearer
# key_metrics_<METRICS_API_KEY>`. Leave empty to disable the endpoint (404).
METRICS_API_KEY=
METRICS_REFRESH_MS=45000
# OAuth sign-in (Google / Discord / Twitch). Leave a provider's pair empty to
# disable it. Redirect URIs to register with each provider are
# ${APP_BASE_URL}/api/auth/{google,discord,twitch}/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Donation Platform <no-reply@example.com>"
APP_BASE_URL=http://localhost:5173
PORT=3001
DATABASE_URL="file:./dev.db"
RATE_LIMIT_SPEND=20
RATE_LIMIT_AUTH=5
RATE_LIMIT_METRICS=30
# How often (ms) the auction scheduler checks for OPEN auctions past their
# ends_at and closes them, kicking off the payment cascade.
AUCTION_CLOSE_INTERVAL_MS=30000
# OpenTelemetry tracing → esa-observability otelcol gateway (shared network).
# Backend exports OTLP HTTP here; the browser exports via nginx /traces proxy
# (VITE_OTEL_ENDPOINT). Tracing is DISABLED by default — set OTEL_TRACES_ENABLED
# to true to enable backend tracing.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otelcol:4318
OTEL_SERVICE_NAME=esa-dono-backend
OTEL_TRACES_SAMPLER_ARG=1.0
OTEL_TRACES_ENABLED=false
# Client (build-time, inlined by Vite). Browser exports OTLP via the nginx
# /traces proxy to the same otelcol gateway. Set VITE_OTEL_ENABLED=true to
# enable browser tracing.
VITE_OTEL_ENDPOINT=/traces
VITE_OTEL_SERVICE_NAME=esa-dono-frontend
VITE_OTEL_SAMPLE_RATE=1.0
VITE_OTEL_ENABLED=false
